# Copy this file to .env and fill in your values

# Your bot token — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your bot's Application ID (General Information tab)
DISCORD_CLIENT_ID=your_client_id_here

# Target guild (server) ID — commands are registered only here
GUILD_ID=1531394302956011603

# Role ID that represents "has server tag / is verified member"
# Members without this role cannot use /deob or /dump
# Admins and Boosters are always exempt (leave blank to disable the check)
MEMBER_ROLE_ID=
