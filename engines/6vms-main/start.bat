@echo off
title 6Vms Setup ^& Start
cd /d "%~dp0"

:: ?????? First-run setup (only runs checks once per launch of this bat) ????????????????????????????????????
goto setup

:setup
echo ============================================
echo   6Vms - Setup ^& Start
echo ============================================
echo.

:: ?????? 1. Check Python ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
python --version >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Python not found. Download it from https://python.org and re-run.
    pause & exit /b 1
)
echo [OK] Python found.

:: ?????? 2. Install Python dependencies ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
echo [*] Installing Python requirements...
python -m pip install -q -r requirements.txt
if errorlevel 1 (
    echo [ERROR] pip install failed. Check your internet connection.
    pause & exit /b 1
)
echo [OK] Python requirements installed.

:: ?????? 3. Download + extract Lune v0.10.4 if not present ????????????????????????????????????????????????????????????????????????
if exist lune.exe (
    echo [OK] lune.exe already present.
) else (
    echo [*] Downloading Lune v0.10.4...
    curl -L -o lune_tmp.zip "https://github.com/lune-org/lune/releases/download/v0.10.4/lune-0.10.4-windows-x86_64.zip"
    if errorlevel 1 (
        echo [ERROR] Download failed. Check your internet connection.
        del /f /q lune_tmp.zip >nul 2>&1
        pause & exit /b 1
    )
    echo [*] Extracting lune.exe...
    powershell -NoProfile -Command "Expand-Archive -Force -Path 'lune_tmp.zip' -DestinationPath '.'"
    del /f /q lune_tmp.zip >nul 2>&1
    if not exist lune.exe (
        echo [ERROR] lune.exe not found after extraction.
        pause & exit /b 1
    )
    echo [OK] lune.exe ready.
)

:: ?????? 4. Check .NET 9 runtime ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
dotnet --list-runtimes 2>nul | findstr /C:"Microsoft.NETCore.App 9." >nul 2>&1
if errorlevel 1 (
    echo [!] .NET 9 runtime not found. Installing via Microsoft dotnet-install script...
    curl -L -s -o dotnet-install.ps1 "https://dot.net/v1/dotnet-install.ps1"
    if exist dotnet-install.ps1 (
        powershell -NoProfile -ExecutionPolicy Bypass -File dotnet-install.ps1 -Runtime dotnet -Channel 9.0
        del /f /q dotnet-install.ps1 >nul 2>&1
        dotnet --list-runtimes 2>nul | findstr /C:"Microsoft.NETCore.App 9." >nul 2>&1
        if errorlevel 1 (
            echo [!] Install completed but dotnet not in PATH yet.
            echo     If .lph2 or .ib2 fail, restart this bat after rebooting once.
        ) else (
            echo [OK] .NET 9 runtime installed.
        )
    ) else (
        echo [!] Could not download dotnet-install.ps1. Install .NET 9 manually:
        echo     https://dotnet.microsoft.com/download/dotnet/9.0
    )
) else (
    echo [OK] .NET 9 runtime found.
)

:: ?????? 5. Verify config.py ?????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
findstr /C:"YOUR_BOT_TOKEN_HERE" config.py >nul 2>&1
if not errorlevel 1 (
    echo.
    echo [!] config.py still has placeholder values.
    echo     Open config.py and fill in your TOKEN and CHANNEL_ID, then re-run.
    echo.
    pause & exit /b 1
)

:: ?????? 6. Install Node.js dependencies (PromDeobf) ????????????????????????????????????????????????????????????????????????
if exist PromDeobf\package.json (
    echo [*] Installing Node.js dependencies for PromDeobf...
    cd PromDeobf
    call npm install --no-audit --no-fund >nul 2>&1
    if errorlevel 1 (
        echo [!] npm install failed for PromDeobf. Check node/npm installation.
    ) else (
        echo [OK] PromDeobf dependencies installed.
    )
    cd ..
)

:: ?????? Menu ??????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
:menu
echo.
echo ============================================
echo   6Vms - Menu
echo ============================================
echo.
echo   1. Run the bot
echo   2. Restart the bot  (if already running, restarts the process)
echo   3. Shut down        (Ctrl+C while bot is running)
echo.
set /p CHOICE="Enter choice [1-3]: "

if "%CHOICE%"=="1" goto run
if "%CHOICE%"=="2" goto run
if "%CHOICE%"=="3" (
    echo.
    echo [*] Press Ctrl+C in the bot window to shut it down.
    pause
    goto menu
)

echo [!] Invalid choice. Please enter 1, 2, or 3.
goto menu

:: ?????? Run / restart loop ????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????????
:run
echo.
echo [*] Starting 6Vms bot...
echo     Press Ctrl+C to stop cleanly.
echo.

:loop
python bot.py
set EXIT_CODE=%errorlevel%

:: 42 = intentional restart via .restart command ??? no countdown, just restart
if %EXIT_CODE%==42 (
    echo.
    echo [*] Restart requested. Restarting now...
    echo.
    goto loop
)

:: 0 = clean shutdown (Ctrl+C caught by Python)
if %EXIT_CODE%==0 goto stopped

:: anything else = crash ??? wait 5 seconds then auto-restart
echo.
echo [!] Bot exited with code %EXIT_CODE%. Restarting in 5 seconds...
echo     Close this window now to cancel.
echo.
timeout /t 5 /nobreak >nul
goto loop

:stopped
echo.
echo [*] Bot stopped cleanly.
echo.
goto menu